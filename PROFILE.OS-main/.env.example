# void / definescloud — PROFILE.OS
# Set this to your actual portfolio URL before deploying.
# The default is inferred from the supplied support-email domain.
NEXT_PUBLIC_SITE_URL=https://definescloud.site
NEXT_PUBLIC_OS_VERSION=6.9.0

# Public Discord user ID. Lanyard must be monitoring this user for live presence.
NEXT_PUBLIC_LANYARD_USER_ID=337964487241891840
NEXT_PUBLIC_LANYARD_API_URL=https://api.lanyard.rest/v1/users/337964487241891840
NEXT_PUBLIC_LANYARD_WS_URL=wss://api.lanyard.rest/socket

# Optional: set your real GitHub username to enable GitHub links and the API.
# Leave empty to hide the link rather than point to an unrelated account.
NEXT_PUBLIC_GITHUB_USERNAME=

# Optional server-side GitHub token for higher API limits.
# Never prefix secrets with NEXT_PUBLIC_ or commit .env files.
GITHUB_TOKEN=
